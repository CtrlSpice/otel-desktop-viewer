{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "benchmark/main.ts",
    "benchmark/api-types.ts",
    "benchmark/abortable-load.ts",
    "benchmark/abortable-load.test.ts",
    "benchmark/arm-c.ts",
    "benchmark/arm-c.test.ts",
    "benchmark/benchmark-api.ts",
    "benchmark/WaterfallHarness.svelte",
    "benchmark/canonical-oracle.ts",
    "benchmark/canonical-oracle.test.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}

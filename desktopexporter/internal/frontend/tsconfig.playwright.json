{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "benchmark/vite.config.ts",
    "benchmark/vitest.config.ts",
    "benchmark/playwright.config.ts",
    "benchmark/tests/**/*.ts"
  ]
}

@precedence { and @left, or @left }

@top Query { SearchRequest }

SearchRequest { Where? expression LimitClause? | LimitClause }

LimitClause { Limit LimitValue }

Where       { @specialize<Word, "WHERE"> | @specialize<Word, "where"> }
Limit        { @specialize<Word, "LIMIT"> | @specialize<Word, "limit"> }
LimitValue   { Word }

expression { condition | AndExpression | OrExpression }

AndExpression { expression !and And expression }
OrExpression { expression !or Or expression }

condition { Group | Comparison | GlobalText | FreeText }

GlobalText { Word "(" QuotedString ")" }

FreeText { Word | Null }

Group { "(" expression ")" }

Comparison { FieldName (operator value | Between value And value) }

FieldName { AttributeReference | Word }

AttributeReference { Word PathSegment+ TypeAnnotation? }
PathSegment { "[" (QuotedString | Word) "]" }
TypeAnnotation { TypeSeparator Word }

operator { Operator | KeywordOperator }

KeywordOperator {
  Contains | Regexp | Like | In | Is | IsNot { Is Not } |
  NotContains { Not Contains } | NotIn { Not In } |
  NotLike { Not Like } | NotRegexp { Not Regexp }
}

And { @specialize<Word, "AND"> | @specialize<Word, "and"> }
Or  { @specialize<Word, "OR">  | @specialize<Word, "or"> }

Contains { @specialize<Word, "CONTAINS"> | @specialize<Word, "contains"> }
Regexp   { @specialize<Word, "REGEXP">   | @specialize<Word, "regexp"> }
Like     { @specialize<Word, "LIKE">     | @specialize<Word, "like"> }
Is       { @specialize<Word, "IS">       | @specialize<Word, "is"> }
Between  { @specialize<Word, "BETWEEN">  | @specialize<Word, "between"> }
In       { @specialize<Word, "IN">       | @specialize<Word, "in"> }
Not      { @specialize<Word, "NOT">      | @specialize<Word, "not"> }

value { QuotedString | Array | Word | Null }

Null {
  @specialize<Word, "NULL"> | @specialize<Word, "null">
}

Array { "(" commaSep<value> ")" }

commaSep<content> { "" | content ("," content)* }

@tokens {
  Word { $[a-zA-Z0-9_./:\-+@#%&*?{}|\\]+ }

  TypeSeparator { "::" }
  Operator { "=" | "!=" | "<>" | ">" | "<" | ">=" | "<=" }

  QuotedString {
    '"' (![\\\"] | "\\" _ | '""')* '"' |
    "'" (![\\\'] | "\\" _ | "''")* "'"
  }

  space { @whitespace+ }

  @precedence { QuotedString, Operator, TypeSeparator, Word }
}

@skip { space }

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{js,ts,svelte,json,yml,yaml,md,css,html}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{pl,pm}]
indent_style = space
indent_size = 4

[Dockerfile]
indent_style = space
indent_size = 4

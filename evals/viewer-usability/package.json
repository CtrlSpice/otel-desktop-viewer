{
  "name": "otel-cli-usability-evaluation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test": "node --test *.test.ts presentation/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:presentation": "node ../../desktopexporter/internal/frontend/node_modules/svelte-check/bin/svelte-check --tsconfig presentation/tsconfig.json",
    "stage": "node stage-dataset.ts",
    "prepare:run": "node prepare.ts",
    "verify": "node verify.ts",
    "pilot": "node pi-evaluate.ts --task checkout-failure",
    "evaluate": "node pi-evaluate.ts",
    "pilot:legacy": "node run-pilot.ts",
    "overnight:legacy": "node run-overnight.ts",
    "verify:isolation": "node verify-isolation.ts",
    "verify:loader:legacy": "node verify-loader.ts",
    "verify:integration": "node verify-integration.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "promptfoo": "0.124.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "6.0.3"
  }
}

    { "name": "error without content", "state": { "status": "error", "input": {}, "error": { "type": "tool.error", "message": "" } }, "expected": { "tool.status": "error", "tool.input": "{}", "tool.output": "{\"type\":\"tool.error\",\"message\":\"\"}", "tool.is_error": true } },

    { "name": "streaming missing required input", "state": { "status": "streaming" }, "malformed": true, "expected": { "tool.status": "streaming" } },
    { "name": "running missing required input", "state": { "status": "running", "metadata": {} }, "malformed": true, "expected": { "tool.status": "running" } },
    { "name": "completed missing required input", "state": { "status": "completed", "content": [] }, "malformed": true, "expected": { "tool.status": "completed", "tool.output": "[]", "tool.is_error": false } },
    { "name": "error missing required input", "state": { "status": "error", "error": {} }, "malformed": true, "expected": { "tool.status": "error", "tool.output": "{}", "tool.is_error": true } }
